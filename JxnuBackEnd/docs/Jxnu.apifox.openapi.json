{
  "openapi": "3.0.3",
  "info": {
    "title": "Jxnu 课程与选课系统接口",
    "version": "2.0.0",
    "description": "Vue3 与 Spring Boot 课程、排课、选课和个人课表接口。"
  },
  "servers": [{"url": "http://localhost:8082"}],
  "components": {
    "securitySchemes": {
      "token": {"type": "apiKey", "in": "header", "name": "token"}
    },
    "schemas": {
      "Result": {
        "type": "object",
        "properties": {
          "code": {"type": "integer", "example": 1},
          "msg": {"type": "string", "example": "success"},
          "data": {}
        }
      },
      "OfferingRequest": {
        "type": "object",
        "required": ["courseId", "teacherId", "classId", "semesterId", "capacity", "schedules"],
        "properties": {
          "courseId": {"type": "integer"},
          "teacherId": {"type": "integer"},
          "classId": {"type": "integer"},
          "semesterId": {"type": "integer"},
          "capacity": {"type": "integer", "minimum": 1},
          "schedules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "weekday": {"type": "integer", "minimum": 1, "maximum": 7},
                "startPeriod": {"type": "integer", "minimum": 1, "maximum": 11},
                "endPeriod": {"type": "integer", "minimum": 1, "maximum": 11},
                "classroomId": {"type": "integer"}
              }
            }
          }
        }
      }
    }
  },
  "security": [{"token": []}],
  "paths": {
    "/stu/login": {"post": {"security": [], "summary": "学生登录", "responses": {"200": {"description": "成功"}}}},
    "/student/info": {"get": {"summary": "当前学生信息", "responses": {"200": {"description": "成功"}}}},
    "/courses": {
      "get": {"summary": "课程列表", "responses": {"200": {"description": "成功"}}},
      "post": {"summary": "新增课程", "responses": {"200": {"description": "成功"}}}
    },
    "/courses/{id}": {
      "get": {"summary": "课程详情", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}},
      "put": {"summary": "修改课程", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}},
      "delete": {"summary": "删除课程", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}}
    },
    "/teachers": {"get": {"summary": "教师列表", "responses": {"200": {"description": "成功"}}}, "post": {"summary": "新增教师", "responses": {"200": {"description": "成功"}}}},
    "/semesters": {"get": {"summary": "学期列表", "responses": {"200": {"description": "成功"}}}},
    "/classes": {"get": {"summary": "行政班列表", "responses": {"200": {"description": "成功"}}}},
    "/classrooms": {"get": {"summary": "教室列表", "responses": {"200": {"description": "成功"}}}},
    "/class-periods": {"get": {"summary": "节次列表", "responses": {"200": {"description": "成功"}}}},
    "/offerings": {
      "get": {"summary": "开课班列表", "responses": {"200": {"description": "成功"}}},
      "post": {"summary": "新增开课班和排课", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OfferingRequest"}}}}, "responses": {"200": {"description": "成功"}}}
    },
    "/offerings/{id}": {
      "get": {"summary": "开课班详情", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}},
      "put": {"summary": "修改开课班和排课", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}},
      "delete": {"summary": "删除开课班", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}}
    },
    "/offerings/{id}/students": {"get": {"summary": "已选学生名单", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}}},
    "/student/selections": {"get": {"summary": "当前学生已选课程", "parameters": [{"in": "query", "name": "semesterId", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}}},
    "/student/selections/{offeringId}": {
      "post": {"summary": "选课", "parameters": [{"in": "path", "name": "offeringId", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}},
      "delete": {"summary": "退课", "parameters": [{"in": "path", "name": "offeringId", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}}
    },
    "/student/timetable": {"get": {"summary": "个人课表", "parameters": [{"in": "query", "name": "semesterId", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "成功"}}}}
  }
}
