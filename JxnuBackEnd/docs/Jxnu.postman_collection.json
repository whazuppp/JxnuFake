{
  "info": {
    "_postman_id": "a1f2e0d0-9a8d-4e62-9c8d-7f5b7d0a0002",
    "name": "Jxnu 课程与选课系统接口",
    "description": "先登录并将返回的 JWT 保存到 token 环境变量。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {"key": "key", "value": "token", "type": "string"},
      {"key": "value", "value": "{{token}}", "type": "string"},
      {"key": "in", "value": "header", "type": "string"}
    ]
  },
  "variable": [{"key": "baseUrl", "value": "http://localhost:8082"}],
  "item": [
    {"name": "学生登录", "request": {"auth": {"type": "noauth"}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"username\":\"student\",\"password\":\"123456\"}"}, "url": "{{baseUrl}}/stu/login"}},
    {"name": "当前学生信息", "request": {"method": "GET", "url": "{{baseUrl}}/student/info"}},
    {"name": "课程列表", "request": {"method": "GET", "url": "{{baseUrl}}/courses"}},
    {"name": "教师列表", "request": {"method": "GET", "url": "{{baseUrl}}/teachers"}},
    {"name": "学期列表", "request": {"method": "GET", "url": "{{baseUrl}}/semesters"}},
    {"name": "行政班列表", "request": {"method": "GET", "url": "{{baseUrl}}/classes"}},
    {"name": "教室列表", "request": {"method": "GET", "url": "{{baseUrl}}/classrooms"}},
    {"name": "节次列表", "request": {"method": "GET", "url": "{{baseUrl}}/class-periods"}},
    {"name": "开课班列表", "request": {"method": "GET", "url": "{{baseUrl}}/offerings?semesterId=1"}},
    {"name": "新增开课班", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"courseId\":8,\"teacherId\":3,\"classId\":2,\"semesterId\":1,\"capacity\":60,\"schedules\":[{\"weekday\":2,\"startPeriod\":3,\"endPeriod\":4,\"classroomId\":5}]}"}, "url": "{{baseUrl}}/offerings"}},
    {"name": "当前学生已选课程", "request": {"method": "GET", "url": "{{baseUrl}}/student/selections?semesterId=1"}},
    {"name": "选择开课班", "request": {"method": "POST", "url": "{{baseUrl}}/student/selections/12"}},
    {"name": "退出开课班", "request": {"method": "DELETE", "url": "{{baseUrl}}/student/selections/12"}},
    {"name": "个人课表", "request": {"method": "GET", "url": "{{baseUrl}}/student/timetable?semesterId=1"}}
  ]
}
